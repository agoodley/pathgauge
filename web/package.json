{
  "name": "pathgauge-web",
  "private": true,
  "version": "0.0.0",
  "description": "PathGauge dashboard (single-page app embedded in the server binary)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
